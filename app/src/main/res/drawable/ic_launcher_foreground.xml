<?xml version="1.0" encoding="utf-8"?>
<!--
    The app icon's front layer: headphones, the letter M and waves, from the desktop app's
    assets/icon.svg with the same coordinates. That SVG is centered on (627, 627), so a
    1254 x 1254 viewport puts the artwork in the middle of the 108 dp adaptive icon, inside
    the area every launcher shape keeps. Also used as the monochrome layer (Android 13 themed
    icons), which only uses its shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1254"
    android:viewportHeight="1254">

    <!-- Headphone band -->
    <path
        android:pathData="M396,507 A243,243 0 0,1 858,507"
        android:strokeWidth="36">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="627" android:startY="321"
                android:endX="627" android:endY="525">
                <item android:offset="0" android:color="#FFE6FAFC" />
                <item android:offset="1" android:color="#FFC9F2F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left ear cup -->
    <path
        android:pathData="M412,540 L412,682 Q412,702 390,702 C355,700 328,668 328,635 L328,582 C328,548 355,518 390,518 Q412,518 412,540 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="370" android:startY="518"
                android:endX="370" android:endY="702">
                <item android:offset="0" android:color="#FFE6FAFC" />
                <item android:offset="1" android:color="#FFC9F2F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right ear cup: the left one mirrored (x becomes 1254 - x), since vectors have no <use> -->
    <path
        android:pathData="M842,540 L842,682 Q842,702 864,702 C899,700 926,668 926,635 L926,582 C926,548 899,518 864,518 Q842,518 842,540 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="884" android:startY="518"
                android:endX="884" android:endY="702">
                <item android:offset="0" android:color="#FFE6FAFC" />
                <item android:offset="1" android:color="#FFC9F2F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Letter M -->
    <path
        android:pathData="M468,750 L460,505 Q458,465 500,465 Q525,465 545,488 L605,560 Q627,585 649,560 L710,488 Q730,465 755,465 Q797,465 795,505 L790,738 Q788,752 774,750 Q738,740 724,712 L718,596 L662,658 Q627,692 592,658 L536,596 L536,692 Q530,725 488,750 Q472,758 468,750 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="627" android:startY="465"
                android:endX="627" android:endY="756">
                <item android:offset="0" android:color="#FFE6FAFC" />
                <item android:offset="1" android:color="#FFC9F2F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Waves -->
    <path
        android:pathData="M342,794 C420,815 470,800 540,760 C600,725 660,712 730,750 C800,790 850,800 898,794 C860,830 800,830 740,800 C680,770 630,760 560,800 C480,845 390,850 342,794 Z M402,874 C460,885 510,880 580,845 C640,812 690,800 760,830 C800,848 820,852 850,852 C820,875 780,878 740,862 C690,842 650,842 590,878 C520,915 450,910 402,874 Z M556,938 C600,925 630,905 660,890 C700,875 730,890 784,902 C770,915 740,914 715,914 C680,914 660,925 630,935 C600,945 575,945 556,938 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="342" android:startY="730"
                android:endX="509" android:endY="945">
                <item android:offset="0" android:color="#FF58ECE0" />
                <item android:offset="1" android:color="#FF3CC9E3" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
