<?xml version="1.0" encoding="utf-8"?>
<!--
    The app icon's back layer: the desktop icon's ocean gradient (assets/icon.svg), from teal
    at the top right to deep blue at the bottom left. No rounded corners: each launcher cuts
    the icon into its own shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="97.2" android:startY="0"
                android:endX="10.8" android:endY="108">
                <item android:offset="0" android:color="#FF2EC7C3" />
                <item android:offset="0.45" android:color="#FF1089AD" />
                <item android:offset="1" android:color="#FF0A5288" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
